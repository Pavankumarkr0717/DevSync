# Copy to .env for local use. Placeholder values only - never commit real secrets.

# PostgreSQL database name, user and password (local development only)
POSTGRES_DB=devsync
POSTGRES_USER=devsync
POSTGRES_PASSWORD=change-me-local-only

# ASP.NET Core environment; the development identity only works in Development
ASPNETCORE_ENVIRONMENT=Development
# Access-token signing key: base64, at least 32 bytes. Leave EMPTY for local development:
# the API then generates a temporary key at startup (users stay signed in via their session
# cookie, but access tokens are renewed after an API restart). Required outside Development.
DevSync__Auth__SigningKey=
# Send the refresh cookie only over HTTPS. Chrome/Firefox/Edge accept this on http://localhost;
# set to false only for Safari or plain-HTTP hosts other than localhost.
DevSync__Auth__RefreshCookie__Secure=true
# Apply EF Core migrations automatically when the API starts
DevSync__Database__ApplyMigrationsOnStartup=true

# Host ports (bound to 127.0.0.1 only)
DB_PORT=5432
API_PORT=5080
WEB_PORT=8080
